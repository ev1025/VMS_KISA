    // 후보(DINO)·화면 박스(손/SAM/DINO) 안을 점 없이 좌클릭 → 그 박스로 프롬프트
    const dm = DINOMAP[f.clip] || {};
    const claimed = new Set(LB.boxes.map((b, i) => i).filter(i => { const q = seedForBox(i); return q && q.obj !== SM.cur; }));   // 다른 객체의 박스
    if (label === 1 && !SP.length) {                   // 번호 바꾸기: 다른 객체의 박스를 점 없이 탭 → 그 참조샷을 현재 객체로
      const oi = LB.boxes.findIndex((b, i) => claimed.has(i) && x >= b[1] && x <= b[1] + b[3] && y >= b[2] && y <= b[2] + b[4]);
      if (oi >= 0) {
        const q = seedForBox(oi);
        if (q) {
          SM.seeds = SM.seeds.filter(s2 => !(Math.abs(s2.t - t) < 0.01 && s2.obj === SM.cur));   // 현재 객체가 이 프레임에 갖고 있던 참조샷은 버린다
          q.obj = SM.cur; q.i = oi; SP = (q.pts || []).slice(); SMASK = { box: q.box, poly: q.poly || [] };
          LB.boxes[oi][0] = samCls(SM.cur);
          drawObjs(); draw(); saveNow(); return;
        }
      }
    }
    const pool = [...LB.boxes.map((b, i) => ({ b, i })).filter(o => !claimed.has(o.i)), ...autoBoxesAt(dm, t).map(b => ({ b, i: -1 }))];
    const hits = (label === 1 && !SP.length) ? pool.filter(o => x >= o.b[1] && x <= o.b[1] + o.b[3] && y >= o.b[2] && y <= o.b[2] + o.b[4]) : [];
    const hit = hits.sort((a, b) => a.b[3] * a.b[4] - b.b[3] * b.b[4])[0] || null;   // 겹치면 가장 작은 박스
    let body;
    SP.push([+x.toFixed(5), +y.toFixed(5), label]); draw();                       // 탭 점은 항상 남긴다(박스 프롬프트여도 표시·참조샷에 기록)
    if (hit) body = { clip: f.clip, t, pts: [], box: [hit.b[1], hit.b[2], hit.b[3], hit.b[4]] };
    else body = { clip: f.clip, t, pts: SP };
    const gen = _tapGen;
    const r = await fetch("/api/sam2_mask", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }).then(r => r.json()).catch(() => ({}));
    if (f.t !== t || gen !== _tapGen) return;         // 다른 프레임으로 갔거나 그사이 되돌리기 → 결과 버림
    if (!r.box) { SMASK = null; draw(); return; }
    SMASK = { box: r.box, poly: r.poly };
    const nb = [samCls(SM.cur), r.box[0], r.box[1], r.box[2], r.box[3]];
    const sd0 = SM.seeds.find(q => Math.abs(q.t - t) < 0.01 && q.obj === SM.cur);
    let idx = (sd0 && sd0.i != null && LB.boxes[sd0.i]) ? sd0.i : ((hit && hit.i >= 0) ? hit.i : -1);
    if (idx >= 0) LB.boxes[idx] = nb; else { LB.boxes.push(nb); idx = LB.boxes.length - 1; }
    seedSet(r.box, r.poly, SP, idx); dropUnownedPrefill();
    draw(); saveNow();                                 // 탭한 프레임 → 손라벨(객체가 잡은 박스만)
  }
  async function samRecompute() {
    const t = f.t; const sd0 = SM.seeds.find(q => Math.abs(q.t - t) < 0.01 && q.obj === SM.cur);
