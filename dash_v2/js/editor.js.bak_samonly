  const styleHand = () => { const on = !!SM.handRef; bHand.style.background = on ? "var(--blue)" : "var(--panel)"; bHand.style.color = on ? "#06090f" : "var(--tx)"; bHand.style.borderColor = on ? "var(--blue)" : "var(--line)"; };
  styleHand();
