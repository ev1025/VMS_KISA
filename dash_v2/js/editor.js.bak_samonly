        else if (q0 && q0.app && !c.hist) app = q0.app;
        last[obj] = { cx: c.cx, cy: c.cy, t, vx: q0 && dt0 > 0 ? (c.cx - q0.cx) / dt0 : 0, vy: q0 && dt0 > 0 ? (c.cy - q0.cy) / dt0 : 0, app };
