    if (owner) { owner.box = box; owner.i = i; if (owner.obj === SM.cur) SMASK = { box, poly: owner.poly || [] }; drawObjs(); }   // 윤곽선(poly)은 유지
    else { SMASK = { box, poly: [] }; seedSet(box, [], SP, i); }   // 아무 객체도 안 쓰는 박스(손라벨·DINO)면 현재 객체 것으로
    draw();
  };
  async function samPoint(x, y, label) {
    const t = f.t;
    const rc = img.getBoundingClientRect(); const tolX = 10 / rc.width, tolY = 10 / rc.height;
    const near = SP.findIndex(q => Math.abs(q[0] - x) < tolX && Math.abs(q[1] - y) < tolY);
